{
  "name": "concord",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Discord-knockoff voice + text chat for friends. One Cloudflare Worker, zero regrets.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "wrangler dev --port 4189",
    "deploy": "wrangler deploy",
    "smoke": "node test/smoke.mjs",
    "e2e": "node test/e2e.mjs",
    "social": "node test/social.mjs",
    "identity": "node test/identity.mjs",
    "voicefx": "node test/voicefx.mjs",
    "app": "electron .",
    "dist": "electron-builder --win",
    "multirealm": "node test/multirealm.mjs",
    "flair": "node test/flair.mjs",
    "groups": "node test/groups.mjs",
    "uploads": "node test/uploads.mjs",
    "roster": "node test/roster.mjs",
    "threads": "node test/threads.mjs",
    "archive": "node test/archive.mjs",
    "security": "node test/security.mjs",
    "hubsec": "node test/hubsec.mjs",
    "render": "node test/render.mjs",
    "backup": "node test/backup.mjs",
    "outbox": "node test/outbox.mjs",
    "ringing": "node test/ringing.mjs",
    "callring": "node test/callring.mjs",
    "mobile": "node test/mobile.mjs",
    "test": "node test/run-all.mjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright": "^1.62.0",
    "wrangler": "3.114.0",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.keiththeguy.concord",
    "productName": "Concord",
    "files": [
      "electron/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
